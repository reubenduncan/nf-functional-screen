manifest {
    name = 'nf-functional-screen'
    description = 'Contig-associated nitrogen cycling and metal/biocide resistance protein screening'
    nextflowVersion = '>=25.10.0'
}
params {
    input = null
    ncyc_fasta = null
    ncyc_map = null
    bacmet_fasta = null
    outdir = 'results'
    evalue = '1e-5'
    min_identity = 40
    min_query_coverage = 70
    min_subject_coverage = 70
}
outputDir = params.outdir
workflow.output.mode = 'copy'
process {
    executor = 'local'
    errorStrategy = { task.exitStatus in [130, 137, 143, 255] ? 'retry' : 'terminate' }
    maxRetries = 2
}
profiles {
    singularity { singularity.enabled = true; singularity.autoMounts = true }
    docker { docker.enabled = true }
}
